# 推送渠道配置。填哪个用哪个，留空的自动跳过。
# 验证：python run.py --test-push

# ---------- 飞书 ----------
# 群设置 → 群机器人 → 添加机器人 → 自定义机器人
FEISHU_WEBHOOK=
# 开了「签名校验」才填
FEISHU_SECRET=

# ---------- 钉钉 ----------
# 群设置 → 智能群助手 → 添加机器人 → 自定义
# 安全设置选「加签」填密钥；选「自定义关键词」则留空（关键词填「盘中」）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ---------- 企业微信 ----------
# 群设置 → 群机器人 → 添加
WECOM_WEBHOOK=

# ---------- Telegram ----------
# @BotFather 建 bot 拿 token；chat_id 找 @userinfobot
TG_TOKEN=
TG_CHAT_ID=

# ---------- Bark（iOS） ----------
# App 里复制完整 URL，形如 https://api.day.app/xxxxxxxx
BARK_URL=

# ---------- 自定义 Webhook ----------
# POST 结构化 JSON 到你的服务
CUSTOM_WEBHOOK=

# ---------- 通用 ----------
# 是否 @所有人（仅飞书/钉钉，默认关）
AT_ALL=0

# ---------- 数据源与节奏 ----------
# 国内本机用默认 push2（最快）。海外服务器改成 push2delay，实测更稳（6.1s vs 9.4s）
# EM_HOST=push2delay.eastmoney.com
# EM_HIS_HOST=push2his.eastmoney.com
# 采集间隔（秒）。海外服务器采集本身要 5~7s，建议 15
# POLL_SECONDS=15
